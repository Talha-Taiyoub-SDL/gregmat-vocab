# Copy to .env.local for local dev, and add the same two values in Vercel > Project > Settings > Environment Variables.
# Leave them out and the app still works, saving to this browser only (no sign-in, no sync).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
